@model Visit
@{
    ViewData["Title"] = "Edit Visit";
    ViewData["PageTitle"] = "Edit Visit";
}

<div class="page-header">
    <div class="page-header-title">
        <h2><i class="fa-solid fa-pen" style="color:var(--primary);margin-right:10px;"></i>Edit Visit</h2>
        <p>@Model.VisitType — @Model.Participant?.FirstName @Model.Participant?.LastName</p>
    </div>
    <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Back</a>
</div>

<div style="max-width:720px;">
    <form asp-action="Edit" asp-route-id="@Model.VisitId" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="VisitId" />
        <div asp-validation-summary="All" class="validation-summary-errors"></div>
        <div class="card">
            <div class="card-body">
                <div class="form-grid-2">
                    <div class="form-group">
                        <label class="form-label">Participant</label>
                        <select asp-for="ParticipantId" class="form-control" asp-items="ViewBag.Participants"></select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Study</label>
                        <select asp-for="StudyId" class="form-control" asp-items="ViewBag.Studies"></select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Visit Type <span class="required">*</span></label>
                        <select asp-for="VisitType" class="form-control" asp-items="ViewBag.VisitTypes">
                            <option value="">-- Select Type --</option>
                        </select>
                        <span asp-validation-for="VisitType" class="field-validation-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Visit Number</label>
                        <input asp-for="VisitNumber" type="number" class="form-control" min="1" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Scheduled Date <span class="required">*</span></label>
                        <input asp-for="ScheduledDate" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                        <span asp-validation-for="ScheduledDate" class="field-validation-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Completed Date</label>
                        <input asp-for="CompletedDate" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Status <span class="required">*</span></label>
                        <select asp-for="Status" class="form-control" asp-items="ViewBag.Statuses"></select>
                        <span asp-validation-for="Status" class="field-validation-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Location</label>
                        <select asp-for="Location" class="form-control" asp-items="ViewBag.Locations">
                            <option value="">-- Select Location --</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Assigned Staff</label>
                        <select asp-for="AssignedStaffId" class="form-control" asp-items="ViewBag.Staff">
                            <option value="">-- Unassigned --</option>
                        </select>
                    </div>
                    <div class="form-group" style="grid-column:1/-1;">
                        <label class="form-label">Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>
            <div class="card-footer" style="display:flex;gap:10px;justify-content:flex-end;">
                <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button>
            </div>
        </div>
    </form>
</div>
