@model PediTrack.Models.ViewModels.CreateUserViewModel
@{
    ViewData["Title"]     = "New User";
    ViewData["PageTitle"] = "Create User";
}

<div class="page-header">
    <div class="page-header-title">
        <h2><i class="fa-solid fa-user-plus" style="color:var(--primary);margin-right:10px;"></i>Create User</h2>
        <p>Add a new Admin or Customer account</p>
    </div>
    <a href="@Url.Action("Users")" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Back</a>
</div>

<div style="max-width:600px;">
    <form asp-action="CreateUser" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation-summary-errors"></div>

        <div class="card">
            <div class="card-body">

                <div class="form-section">
                    <div class="form-section-title"><i class="fa-solid fa-id-card" style="margin-right:6px;"></i>Account Details</div>
                    <div class="form-grid-2">
                        <div class="form-group" style="grid-column:1/-1;">
                            <label class="form-label" asp-for="Email">Email Address <span class="required">*</span></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="user@example.com" />
                            <span asp-validation-for="Email" class="field-validation-error"></span>
                        </div>
                        <div class="form-group" style="grid-column:1/-1;">
                            <label class="form-label" asp-for="DisplayName">Display Name <span class="required">*</span></label>
                            <input asp-for="DisplayName" class="form-control" placeholder="Full name shown in the app" />
                            <span asp-validation-for="DisplayName" class="field-validation-error"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="Password">Password <span class="required">*</span></label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Min 8 chars, upper, number, symbol" />
                            <span asp-validation-for="Password" class="field-validation-error"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="ConfirmPassword">Confirm Password <span class="required">*</span></label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <div class="form-section-title"><i class="fa-solid fa-shield-halved" style="margin-right:6px;"></i>Role & Access</div>
                    <div class="form-grid-2">
                        <div class="form-group">
                            <label class="form-label" asp-for="Role">Role <span class="required">*</span></label>
                            <select asp-for="Role" class="form-control" id="roleSelect">
                                <option value="Admin">Admin — Full access</option>
                                <option value="Customer" selected>Customer — Guardian portal</option>
                            </select>
                        </div>
                        <div class="form-group" id="participantGroup">
                            <label class="form-label" asp-for="ParticipantId">Linked Participant</label>
                            <select asp-for="ParticipantId" class="form-control" asp-items="ViewBag.Participants">
                                <option value="">— None —</option>
                            </select>
                            <div style="font-size:0.78rem;color:var(--text-muted);margin-top:4px;">Required for Customer role so they can see their child's data.</div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="card-footer" style="display:flex;gap:10px;justify-content:flex-end;">
                <a href="@Url.Action("Users")" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Create Account</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('roleSelect').addEventListener('change', function () {
            document.getElementById('participantGroup').style.opacity = this.value === 'Customer' ? '1' : '0.4';
        });
    </script>
}
