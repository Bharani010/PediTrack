@model PediTrack.Models.ViewModels.EditUserViewModel
@{
    ViewData["Title"]     = "Edit User";
    ViewData["PageTitle"] = "Edit User";
}

<div class="page-header">
    <div class="page-header-title">
        <h2><i class="fa-solid fa-user-pen" style="color:var(--primary);margin-right:10px;"></i>Edit User</h2>
        <p>Update account for @Model.Email</p>
    </div>
    <a href="@Url.Action("Users")" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Back</a>
</div>

<div style="max-width:600px;">
    <form asp-action="EditUser" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="validation-summary-errors"></div>

        <div class="card">
            <div class="card-body">

                <div class="form-section">
                    <div class="form-section-title"><i class="fa-solid fa-id-card" style="margin-right:6px;"></i>Account Details</div>
                    <div class="form-grid-2">
                        <div class="form-group" style="grid-column:1/-1;">
                            <label class="form-label" asp-for="Email">Email Address <span class="required">*</span></label>
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="field-validation-error"></span>
                        </div>
                        <div class="form-group" style="grid-column:1/-1;">
                            <label class="form-label" asp-for="DisplayName">Display Name <span class="required">*</span></label>
                            <input asp-for="DisplayName" class="form-control" />
                            <span asp-validation-for="DisplayName" class="field-validation-error"></span>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <div class="form-section-title"><i class="fa-solid fa-shield-halved" style="margin-right:6px;"></i>Role & Access</div>
                    <div class="form-grid-2">
                        <div class="form-group">
                            <label class="form-label" asp-for="Role">Role <span class="required">*</span></label>
                            <select asp-for="Role" class="form-control">
                                <option value="Admin">Admin — Full access</option>
                                <option value="Customer">Customer — Guardian portal</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="ParticipantId">Linked Participant</label>
                            <select asp-for="ParticipantId" class="form-control" asp-items="ViewBag.Participants">
                                <option value="">— None —</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="IsActive">Account Status</label>
                            <select asp-for="IsActive" class="form-control">
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <div class="form-section-title"><i class="fa-solid fa-key" style="margin-right:6px;"></i>Password Reset <span style="font-size:0.75rem;color:var(--text-muted);font-weight:400;">(optional — leave blank to keep current)</span></div>
                    <div class="form-grid-2">
                        <div class="form-group">
                            <label class="form-label" asp-for="NewPassword">New Password</label>
                            <input asp-for="NewPassword" type="password" class="form-control" placeholder="Min 8 chars" />
                            <span asp-validation-for="NewPassword" class="field-validation-error"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="ConfirmNewPassword">Confirm New Password</label>
                            <input asp-for="ConfirmNewPassword" type="password" class="form-control" />
                            <span asp-validation-for="ConfirmNewPassword" class="field-validation-error"></span>
                        </div>
                    </div>
                </div>

            </div>
            <div class="card-footer" style="display:flex;gap:10px;justify-content:flex-end;">
                <a href="@Url.Action("Users")" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
