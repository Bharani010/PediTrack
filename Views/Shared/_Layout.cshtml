<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] — PediTrack</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Bootstrap 5 -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <!-- Site CSS -->
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

  @await RenderSectionAsync("Styles", required: false)
</head>
<body>

  <!-- ===== SIDEBAR ===== -->
  <nav id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-icon"><i class="fa-solid fa-heart-pulse"></i></div>
      <h1>PediTrack</h1>
      <p>Pediatric Research Portal</p>
    </div>

    <div class="sidebar-nav">
      <span class="sidebar-section-label">Main</span>

      <a class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
         href="@Url.Action("Index","Home")">
        <i class="fa-solid fa-chart-pie"></i> Dashboard
      </a>

      <a class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Participants" ? "active" : "")"
         href="@Url.Action("Index","Participants")">
        <i class="fa-solid fa-child-reaching"></i> Participants
      </a>

      <a class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Studies" ? "active" : "")"
         href="@Url.Action("Index","Studies")">
        <i class="fa-solid fa-flask"></i> Studies
      </a>

      <a class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Visits" ? "active" : "")"
         href="@Url.Action("Index","Visits")">
        <i class="fa-solid fa-calendar-check"></i> Visits
      </a>

      <a class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ConsentForms" ? "active" : "")"
         href="@Url.Action("Index","ConsentForms")">
        <i class="fa-solid fa-file-signature"></i> Consent Forms
      </a>

      <span class="sidebar-section-label">Team & Docs</span>

      <a class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Investigators" ? "active" : "")"
         href="@Url.Action("Index","Investigators")">
        <i class="fa-solid fa-user-doctor"></i> Investigators
      </a>

      <a class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")"
         href="@Url.Action("Index","Reports")">
        <i class="fa-solid fa-chart-bar"></i> Reports
      </a>

      <a class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "DataDictionary" ? "active" : "")"
         href="@Url.Action("Index","DataDictionary")">
        <i class="fa-solid fa-book-open"></i> Data Dictionary
      </a>
    </div>

    <div class="sidebar-footer">
      <div style="font-size:0.78rem; color:rgba(255,255,255,0.5); margin-bottom:4px;">
        <i class="fa-solid fa-hospital-user" style="margin-right:6px;"></i>Meridian Children's Hospital
      </div>
      <div style="color:rgba(255,255,255,0.25); font-size:0.7rem;">Pediatrics · Research IT · v1.0</div>
    </div>
  </nav>

  <!-- ===== MAIN CONTENT ===== -->
  <div id="main-content">

    <!-- Top Bar -->
    <header class="topbar">
      <button class="btn btn-secondary btn-icon d-md-none" id="sidebar-toggle" style="border:none;">
        <i class="fa-solid fa-bars"></i>
      </button>
      <span class="topbar-title">@(ViewData["PageTitle"] ?? ViewData["Title"] ?? "PediTrack")</span>
      <span class="topbar-meta">
        <i class="fa-regular fa-calendar" style="margin-right:5px;"></i>@DateTime.Now.ToString("MMMM d, yyyy")
      </span>
    </header>

    <!-- Flash Messages -->
    <div style="padding: 0 28px; margin-top: 16px;">
      @if (TempData["Success"] != null)
      {
        <div class="alert alert-success">
          <i class="fa-solid fa-circle-check"></i>
          <span>@TempData["Success"]</span>
        </div>
      }
      @if (TempData["Error"] != null)
      {
        <div class="alert alert-danger">
          <i class="fa-solid fa-circle-exclamation"></i>
          <span>@TempData["Error"]</span>
        </div>
      }
    </div>

    <!-- Page Body -->
    <main class="page-body">
      @RenderBody()
    </main>

  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <!-- jQuery -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

  <script>
    // Mobile sidebar toggle
    document.getElementById('sidebar-toggle')?.addEventListener('click', () => {
      document.getElementById('sidebar').classList.toggle('open');
    });

    // Auto-dismiss alerts after 5s
    document.querySelectorAll('.alert').forEach(el => {
      setTimeout(() => { el.style.transition = 'opacity 0.4s'; el.style.opacity = '0'; setTimeout(() => el.remove(), 400); }, 5000);
    });
  </script>

  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
