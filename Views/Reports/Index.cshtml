@{
    ViewData["Title"] = "Reports";
    ViewData["PageTitle"] = "Reports & Analytics";
}

<div class="page-header">
    <div class="page-header-title">
        <h2><i class="fa-solid fa-chart-bar" style="color:var(--primary);margin-right:10px;"></i>Reports &amp; Analytics</h2>
        <p>Generate filtered views, export to CSV, and print reports across all study data</p>
    </div>
</div>

<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px;">

    <!-- Participant Report -->
    <div class="card" style="border-top:3px solid var(--primary);">
        <div class="card-body" style="padding:24px;">
            <div style="width:50px;height:50px;background:var(--primary-light);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;color:var(--primary);margin-bottom:16px;">
                <i class="fa-solid fa-child-reaching"></i>
            </div>
            <h4 style="font-size:1rem;font-weight:700;margin-bottom:6px;">Participant Status Report</h4>
            <p style="font-size:0.85rem;color:var(--text-secondary);margin-bottom:16px;">
                Filter by study, status, or enrollment date range. Export to CSV or print.
            </p>
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
                <a href="@Url.Action("Participants")" class="btn btn-primary btn-sm" style="flex:1;justify-content:center;">
                    <i class="fa-solid fa-eye"></i> View
                </a>
                <a href="@Url.Action("ExportParticipantsCsv")" class="btn btn-glass btn-sm">
                    <i class="fa-solid fa-file-csv"></i> CSV
                </a>
                <a href="@Url.Action("ParticipantsPrint")" class="btn btn-glass btn-sm" target="_blank">
                    <i class="fa-solid fa-print"></i> Print
                </a>
            </div>
        </div>
    </div>

    <!-- Visit Report -->
    <div class="card" style="border-top:3px solid var(--success);">
        <div class="card-body" style="padding:24px;">
            <div style="width:50px;height:50px;background:rgba(16,185,129,0.1);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;color:var(--success);margin-bottom:16px;">
                <i class="fa-solid fa-calendar-check"></i>
            </div>
            <h4 style="font-size:1rem;font-weight:700;margin-bottom:6px;">Visit Activity Report</h4>
            <p style="font-size:0.85rem;color:var(--text-secondary);margin-bottom:16px;">
                Track completion rates, missed visits, and upcoming scheduled visits by study.
            </p>
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
                <a href="@Url.Action("Visits")" class="btn btn-success btn-sm" style="flex:1;justify-content:center;">
                    <i class="fa-solid fa-eye"></i> View
                </a>
                <a href="@Url.Action("ExportVisitsCsv")" class="btn btn-glass btn-sm">
                    <i class="fa-solid fa-file-csv"></i> CSV
                </a>
            </div>
        </div>
    </div>

    <!-- Consent Report -->
    <div class="card" style="border-top:3px solid var(--warning);">
        <div class="card-body" style="padding:24px;">
            <div style="width:50px;height:50px;background:rgba(245,158,11,0.1);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;color:var(--warning);margin-bottom:16px;">
                <i class="fa-solid fa-file-signature"></i>
            </div>
            <h4 style="font-size:1rem;font-weight:700;margin-bottom:6px;">Consent Form Report</h4>
            <p style="font-size:0.85rem;color:var(--text-secondary);margin-bottom:16px;">
                Review consent status, identify expired consents, and flag re-consent requirements.
            </p>
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
                <a href="@Url.Action("Consents")" class="btn btn-sm" style="flex:1;justify-content:center;background:linear-gradient(135deg,#d97706,var(--warning));color:#fff;box-shadow:0 2px 8px rgba(245,158,11,0.3);">
                    <i class="fa-solid fa-eye"></i> View
                </a>
                <a href="@Url.Action("ExportConsentsCsv")" class="btn btn-glass btn-sm">
                    <i class="fa-solid fa-file-csv"></i> CSV
                </a>
            </div>
        </div>
    </div>

    <!-- SQL Analytics -->
    <div class="card" style="border-top:3px solid var(--accent2);">
        <div class="card-body" style="padding:24px;">
            <div style="width:50px;height:50px;background:rgba(99,102,241,0.1);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;color:var(--accent2);margin-bottom:16px;">
                <i class="fa-solid fa-database"></i>
            </div>
            <h4 style="font-size:1rem;font-weight:700;margin-bottom:6px;">SQL Analytics</h4>
            <p style="font-size:0.85rem;color:var(--text-secondary);margin-bottom:16px;">
                Live data from T-SQL stored procedures and a SQL Server view — advanced aggregations with CASE, GROUP BY, and optional parameters.
            </p>
            <a href="@Url.Action("SqlAnalytics")" class="btn btn-sm" style="width:100%;justify-content:center;background:linear-gradient(135deg,#4f46e5,var(--accent2));color:#fff;box-shadow:0 2px 8px rgba(99,102,241,0.3);">
                <i class="fa-solid fa-eye"></i> View Analytics
            </a>
        </div>
    </div>

</div>

<!-- ── T-SQL Analytics Feature Summary ────────────────────────────────── -->
<div style="margin-top:32px;">
    <div class="card" style="border-left:4px solid var(--accent2);background:rgba(99,102,241,0.03);">
        <div class="card-body" style="padding:20px 24px;">
            <div style="display:flex;align-items:flex-start;gap:14px;">
                <div style="width:40px;height:40px;background:rgba(99,102,241,0.1);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;color:var(--accent2);flex-shrink:0;">
                    <i class="fa-solid fa-code"></i>
                </div>
                <div>
                    <h5 style="font-weight:700;margin:0 0 6px;">T-SQL Analytics — Implemented Directly in SQL Server</h5>
                    <p style="font-size:.87rem;color:var(--text-secondary);margin:0 0 10px;">
                        PediTrack uses a <strong>SQL Server view</strong> (<code>vw_StudyEnrollmentSummary</code>) and two <strong>stored procedures</strong>
                        (<code>usp_GetEnrollmentSummaryByStudy</code>, <code>usp_GetParticipantVisitHistory</code>) for advanced aggregations
                        with <code>CASE</code>, <code>GROUP BY</code>, and optional parameter filtering.
                        Results are surfaced via <code>FromSqlRaw</code> into keyless EF Core entities and displayed as interactive analytics.
                    </p>
                    <div style="display:flex;gap:8px;flex-wrap:wrap;">
                        <a href="@Url.Action("SqlAnalytics")" class="btn btn-glass btn-sm">
                            <i class="fa-solid fa-database"></i> Open SQL Analytics
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
