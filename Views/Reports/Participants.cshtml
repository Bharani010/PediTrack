@model ReportViewModel
@{
    ViewData["Title"] = "Participant Report";
    ViewData["PageTitle"] = "Participant Status Report";
}

<!-- Print Header (hidden on screen) -->
<div class="print-header" style="margin-bottom:20px;padding-bottom:16px;border-bottom:2px solid #ddd;">
    <h2 style="margin:0 0 4px;">PediTrack — Participant Status Report</h2>
    <p style="margin:0;color:#666;font-size:0.85rem;">@Model.Institution · Generated @Model.GeneratedAt.ToString("MMMM d, yyyy h:mm tt")</p>
</div>

<div class="page-header no-print">
    <div class="page-header-title">
        <h2><i class="fa-solid fa-child-reaching" style="color:var(--primary);margin-right:10px;"></i>Participant Status Report</h2>
        <p>@Model.TotalRecords record@(Model.TotalRecords == 1 ? "" : "s") found</p>
    </div>
    <div class="page-header-actions">
        <button onclick="window.print()" class="btn btn-glass"><i class="fa-solid fa-print"></i> Print</button>
        <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Back</a>
    </div>
</div>

<!-- Filters -->
<div class="filter-bar no-print">
    <form method="get" style="display:flex;gap:10px;flex-wrap:wrap;width:100%;align-items:flex-end;">
        <div style="flex:1;min-width:160px;">
            <label style="font-size:0.78rem;font-weight:600;color:var(--text-secondary);display:block;margin-bottom:4px;">Study</label>
            <select name="studyId" class="form-control">
                <option value="">All Studies</option>
                @foreach (var s in Model.AvailableStudies)
                {
                    <option value="@s.StudyId" selected="@(Model.StudyId == s.StudyId)">@s.StudyCode – @s.StudyName</option>
                }
            </select>
        </div>
        <div style="min-width:140px;">
            <label style="font-size:0.78rem;font-weight:600;color:var(--text-secondary);display:block;margin-bottom:4px;">Status</label>
            <select name="status" class="form-control">
                <option value="">All</option>
                <option value="Active" selected="@(Model.Status == "Active")">Active</option>
                <option value="Withdrawn" selected="@(Model.Status == "Withdrawn")">Withdrawn</option>
                <option value="Completed" selected="@(Model.Status == "Completed")">Completed</option>
            </select>
        </div>
        <div style="min-width:140px;">
            <label style="font-size:0.78rem;font-weight:600;color:var(--text-secondary);display:block;margin-bottom:4px;">Enrolled From</label>
            <input type="date" name="from" class="form-control" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
        </div>
        <div style="min-width:140px;">
            <label style="font-size:0.78rem;font-weight:600;color:var(--text-secondary);display:block;margin-bottom:4px;">Enrolled To</label>
            <input type="date" name="to" class="form-control" value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn btn-primary" style="align-self:flex-end;"><i class="fa-solid fa-filter"></i> Apply</button>
        <a href="@Url.Action("Participants")" class="btn btn-secondary" style="align-self:flex-end;">Clear</a>
    </form>
</div>

<!-- Summary Badges -->
@if (Model.StatusBreakdown.Any())
{
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px;" class="no-print">
        @foreach (var kv in Model.StatusBreakdown)
        {
            <div style="background:var(--bg-white);border:1px solid var(--border);border-radius:8px;padding:10px 16px;display:flex;align-items:center;gap:10px;box-shadow:var(--shadow-sm);">
                <span class="badge badge-@kv.Key.ToLower()">@kv.Key</span>
                <span style="font-size:1.1rem;font-weight:800;color:var(--text-primary);">@kv.Value</span>
            </div>
        }
    </div>
}

<div class="card">
    <div class="table-wrapper">
        <table class="table">
            <thead>
                <tr>
                    <th>MRN</th><th>Name</th><th>Age</th><th>Gender</th>
                    <th>Enrolled</th><th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Participants)
                {
                    <tr>
                        <td><code style="font-size:0.82rem;color:var(--primary);">@p.MRN</code></td>
                        <td style="font-weight:600;">@p.FirstName @p.LastName</td>
                        <td>@p.Age yrs</td>
                        <td>@p.Gender</td>
                        <td style="font-size:0.82rem;">@p.EnrollmentDate.ToString("MMM d, yyyy")</td>
                        <td><span class="badge badge-@p.Status.ToLower()">@p.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Participants.Any())
    {
        <div class="empty-state"><div class="empty-state-icon"><i class="fa-solid fa-magnifying-glass"></i></div><h4>No records match your filters</h4></div>
    }
</div>
