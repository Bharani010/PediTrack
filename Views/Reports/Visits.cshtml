@model ReportViewModel
@{
    ViewData["Title"] = "Visit Report";
    ViewData["PageTitle"] = "Visit Activity Report";
}

<div class="page-header no-print">
    <div class="page-header-title">
        <h2><i class="fa-solid fa-calendar-check" style="color:var(--success);margin-right:10px;"></i>Visit Activity Report</h2>
        <p>@Model.TotalRecords visit record@(Model.TotalRecords == 1 ? "" : "s") found</p>
    </div>
    <div class="page-header-actions">
        <a href="@Url.Action("ExportVisitsCsv", new { studyId = Model.StudyId, status = Model.Status, from = Model.DateFrom?.ToString("yyyy-MM-dd"), to = Model.DateTo?.ToString("yyyy-MM-dd") })"
           class="btn btn-glass"><i class="fa-solid fa-file-csv"></i> Export CSV</a>
        <button onclick="window.print()" class="btn btn-glass"><i class="fa-solid fa-print"></i> Print</button>
        <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Back</a>
    </div>
</div>

<div class="filter-bar no-print">
    <form method="get" style="display:flex;gap:10px;flex-wrap:wrap;width:100%;align-items:flex-end;">
        <div style="flex:1;min-width:160px;">
            <label style="font-size:0.78rem;font-weight:600;color:var(--text-secondary);display:block;margin-bottom:4px;">Study</label>
            <select name="studyId" class="form-control">
                <option value="">All Studies</option>
                @foreach (var s in Model.AvailableStudies)
                {
                    <option value="@s.StudyId" selected="@(Model.StudyId == s.StudyId)">@s.StudyCode</option>
                }
            </select>
        </div>
        <div style="min-width:140px;">
            <label style="font-size:0.78rem;font-weight:600;color:var(--text-secondary);display:block;margin-bottom:4px;">Status</label>
            <select name="status" class="form-control">
                <option value="">All</option>
                @foreach (var st in new[]{"Scheduled","Completed","Missed","Cancelled","Rescheduled"})
                { <option value="@st" selected="@(Model.Status == st)">@st</option> }
            </select>
        </div>
        <div style="min-width:140px;">
            <label style="font-size:0.78rem;font-weight:600;color:var(--text-secondary);display:block;margin-bottom:4px;">From</label>
            <input type="date" name="from" class="form-control" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
        </div>
        <div style="min-width:140px;">
            <label style="font-size:0.78rem;font-weight:600;color:var(--text-secondary);display:block;margin-bottom:4px;">To</label>
            <input type="date" name="to" class="form-control" value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn btn-primary" style="align-self:flex-end;"><i class="fa-solid fa-filter"></i> Apply</button>
        <a href="@Url.Action("Visits")" class="btn btn-secondary" style="align-self:flex-end;">Clear</a>
    </form>
</div>

@if (Model.StatusBreakdown.Any())
{
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px;" class="no-print">
        @foreach (var kv in Model.StatusBreakdown)
        {
            <div style="background:var(--bg-white);border:1px solid var(--border);border-radius:8px;padding:10px 16px;display:flex;align-items:center;gap:10px;box-shadow:var(--shadow-sm);">
                <span class="badge badge-@kv.Key.ToLower()">@kv.Key</span>
                <span style="font-size:1.1rem;font-weight:800;color:var(--text-primary);">@kv.Value</span>
            </div>
        }
    </div>
}

<div class="card">
    <div class="table-wrapper">
        <table class="table">
            <thead>
                <tr><th>Participant</th><th>Study</th><th>Visit Type</th><th>Scheduled</th><th>Completed</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var v in Model.Visits)
                {
                    <tr>
                        <td style="font-weight:600;">@v.Participant?.FirstName @v.Participant?.LastName</td>
                        <td><code style="font-size:0.8rem;color:var(--primary);">@v.Study?.StudyCode</code></td>
                        <td>@v.VisitType</td>
                        <td style="font-size:0.82rem;">@v.ScheduledDate.ToString("MMM d, yyyy")</td>
                        <td style="font-size:0.82rem;">@(v.CompletedDate.HasValue ? v.CompletedDate.Value.ToString("MMM d, yyyy") : "—")</td>
                        <td><span class="badge badge-@v.Status.ToLower()">@v.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Visits.Any())
    {
        <div class="empty-state"><div class="empty-state-icon"><i class="fa-regular fa-calendar"></i></div><h4>No visit records match your filters</h4></div>
    }
</div>
