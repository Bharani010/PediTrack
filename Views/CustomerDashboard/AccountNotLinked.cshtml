@{
    Layout = "_CustomerLayout";
    ViewData["Title"]     = "Account Not Linked";
    ViewData["PageTitle"] = "Account Setup Required";
}

<div style="max-width:500px;margin:60px auto;text-align:center;">
    <div style="font-size:4rem;color:#0891b2;margin-bottom:20px;"><i class="fa-solid fa-link-slash"></i></div>
    <h2 style="font-weight:800;color:var(--text-p);margin-bottom:10px;">Account Not Linked</h2>
    <p style="color:var(--text-s);line-height:1.7;margin-bottom:24px;">
        Your guardian account has not yet been linked to a participant record.
        Please contact the <strong>Meridian Research Team</strong> at
        <a href="mailto:research@meridian.org" style="color:#0891b2;">research@meridian.org</a>
        to have your account connected.
    </p>
    <div class="c-alert c-alert-info" style="text-align:left;">
        <i class="fa-solid fa-circle-info"></i>
        <span>If you believe this is an error, have your <strong>MRN</strong> ready when you contact us.</span>
    </div>
</div>
