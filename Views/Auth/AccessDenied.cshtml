@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Access Denied — PediTrack</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <style>
    body { font-family:'Inter',sans-serif; background:#fafaf9; display:flex; align-items:center; justify-content:center; min-height:100vh; margin:0; }
    .box { text-align:center; max-width:420px; padding:48px 36px; background:#fff; border-radius:20px; box-shadow:0 8px 32px rgba(0,0,0,0.08); }
    .icon { font-size:3.5rem; color:#ef4444; margin-bottom:18px; }
    h1 { font-size:1.5rem; font-weight:800; color:#1c0a00; margin:0 0 10px; }
    p { color:#57534e; font-size:0.9rem; line-height:1.6; }
    a { display:inline-block; margin-top:20px; padding:10px 24px; background:#ea580c; color:#fff; border-radius:10px; text-decoration:none; font-weight:600; font-size:0.9rem; }
    a:hover { background:#c2410c; }
  </style>
</head>
<body>
  <div class="box">
    <div class="icon"><i class="fa-solid fa-lock"></i></div>
    <h1>Access Denied</h1>
    <p>You don't have permission to view this page. Please contact your administrator if you believe this is an error.</p>
    <a href="/Auth/Login"><i class="fa-solid fa-arrow-left" style="margin-right:6px;"></i>Back to Login</a>
  </div>
</body>
</html>
