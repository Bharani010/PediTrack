@model PediTrack.Models.ViewModels.LoginViewModel
@{
    Layout = null; // standalone page — no sidebar
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In — PediTrack</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <style>
    :root {
      --primary: #ea580c;
      --primary-dark: #c2410c;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
      background: linear-gradient(135deg, #1c0a00 0%, #3a1a00 50%, #1c0a00 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .login-wrapper {
      width: 100%;
      max-width: 420px;
      padding: 20px;
    }
    .login-card {
      background: #fff;
      border-radius: 20px;
      padding: 44px 40px 36px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.35);
    }
    .login-logo {
      text-align: center;
      margin-bottom: 28px;
    }
    .login-logo .logo-icon {
      width: 64px; height: 64px;
      background: linear-gradient(135deg, var(--primary), #fb923c);
      border-radius: 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 14px;
      box-shadow: 0 8px 20px rgba(234,88,12,0.3);
    }
    .login-logo .logo-icon i { font-size: 1.8rem; color: #fff; }
    .login-logo h1 { font-size: 1.6rem; font-weight: 800; color: #1c0a00; margin: 0 0 4px; }
    .login-logo p  { font-size: 0.82rem; color: #78716c; margin: 0; }
    .form-label { font-size: 0.85rem; font-weight: 600; color: #1c0a00; margin-bottom: 6px; }
    .form-control {
      border-radius: 10px;
      border: 1.5px solid #e7e5e4;
      padding: 10px 14px;
      font-size: 0.9rem;
      transition: border-color 0.2s;
    }
    .form-control:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(234,88,12,0.12);
      outline: none;
    }
    .btn-login {
      width: 100%;
      padding: 12px;
      background: linear-gradient(135deg, var(--primary), #fb923c);
      border: none;
      border-radius: 10px;
      color: #fff;
      font-weight: 700;
      font-size: 0.95rem;
      cursor: pointer;
      margin-top: 8px;
      transition: opacity 0.2s, transform 0.1s;
    }
    .btn-login:hover { opacity: 0.92; transform: translateY(-1px); }
    .btn-login:active { transform: translateY(0); }
    .validation-summary-errors {
      background: #fef2f2;
      border: 1px solid #fecaca;
      border-radius: 10px;
      padding: 12px 14px;
      font-size: 0.84rem;
      color: #dc2626;
      margin-bottom: 16px;
    }
    .validation-summary-errors ul { margin: 0; padding-left: 18px; }
    .sample-accounts {
      background: #fafaf9;
      border: 1px solid #e7e5e4;
      border-radius: 12px;
      padding: 16px;
      margin-top: 20px;
      font-size: 0.8rem;
    }
    .sample-accounts h6 { font-size: 0.78rem; font-weight: 700; color: #a8a29e; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 10px; }
    .account-row { display: flex; justify-content: space-between; align-items: center; padding: 5px 0; border-bottom: 1px solid #f5f5f4; }
    .account-row:last-child { border-bottom: none; }
    .account-badge { font-size: 0.7rem; font-weight: 600; padding: 2px 8px; border-radius: 99px; }
    .badge-admin    { background: #fef3c7; color: #92400e; }
    .badge-customer { background: #e0f2fe; color: #0369a1; }
    .account-creds  { font-family: 'Courier New', monospace; color: #57534e; font-size: 0.78rem; }
    .divider { display: flex; align-items: center; gap: 10px; margin: 20px 0 0; color: #a8a29e; font-size: 0.78rem; }
    .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: #e7e5e4; }
  </style>
</head>
<body>
  <div class="login-wrapper">
    <div class="login-card">
      <div class="login-logo">
        <div class="logo-icon"><i class="fa-solid fa-heart-pulse"></i></div>
        <h1>PediTrack</h1>
        <p>Meridian Children's Hospital · Research Portal</p>
      </div>

      @if (!ViewData.ModelState.IsValid)
      {
        <div asp-validation-summary="All" class="validation-summary-errors"></div>
      }

      <form asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="mb-3">
          <label asp-for="Email" class="form-label">Email Address</label>
          <input asp-for="Email" class="form-control" placeholder="you@meridian.org" autocomplete="email" autofocus />
          <span asp-validation-for="Email" class="text-danger" style="font-size:0.8rem;"></span>
        </div>

        <div class="mb-3">
          <label asp-for="Password" class="form-label">Password</label>
          <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
          <span asp-validation-for="Password" class="text-danger" style="font-size:0.8rem;"></span>
        </div>

        <div class="mb-3 form-check" style="padding-left:24px;">
          <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe" />
          <label class="form-check-label" for="rememberMe" style="font-size:0.85rem;color:#57534e;">
            Keep me signed in for 7 days
          </label>
        </div>

        <button type="submit" class="btn-login">
          <i class="fa-solid fa-right-to-bracket" style="margin-right:8px;"></i>Sign In
        </button>
      </form>

      <div class="divider">Demo Accounts</div>

      <div class="sample-accounts">
        <h6>Sample login credentials</h6>
        <div class="account-row">
          <div>
            <span class="account-badge badge-admin">Admin</span>
            <div class="account-creds">admin@peditrack.com</div>
          </div>
          <div class="account-creds">Admin@PediTrack2024!</div>
        </div>
        <div class="account-row">
          <div>
            <span class="account-badge badge-customer">Guardian</span>
            <div class="account-creds">p.brooks@email.com</div>
          </div>
          <div class="account-creds">Guardian@PediTrack2024!</div>
        </div>
        <div class="account-row">
          <div>
            <span class="account-badge badge-customer">Guardian</span>
            <div class="account-creds">c.martinez@email.com</div>
          </div>
          <div class="account-creds">Guardian@PediTrack2024!</div>
        </div>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
</body>
</html>
