@model List<DataDictionaryEntry>
@{
    ViewData["Title"] = "Data Dictionary";
    ViewData["PageTitle"] = "Data Dictionary";
    var tables = ViewBag.Tables as List<string> ?? new List<string>();
    var selected = ViewBag.SelectedTable as string ?? "All";
}

<div class="page-header">
    <div class="page-header-title">
        <h2><i class="fa-solid fa-book-open" style="color:var(--primary);margin-right:10px;"></i>Data Dictionary</h2>
        <p>Field-level documentation for all PediTrack database tables</p>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Add Entry</a>
</div>

<!-- Table Filter Tabs -->
<div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px;">
    <a href="@Url.Action("Index")" class="btn @(selected == "All" ? "btn-primary" : "btn-secondary") btn-sm">All Tables</a>
    @foreach (var t in tables)
    {
        <a href="@Url.Action("Index", new{table = t})" class="btn @(selected == t ? "btn-primary" : "btn-secondary") btn-sm">@t</a>
    }
</div>

@{
    var grouped = Model.GroupBy(e => e.TableName).OrderBy(g => g.Key);
}

@foreach (var group in grouped)
{
    <div class="card mb-4">
        <div class="card-header" style="background:var(--primary-light);">
            <span class="card-header-title" style="color:var(--primary);">
                <i class="fa-solid fa-table" style="margin-right:8px;"></i>@group.Key
            </span>
            <span style="font-size:0.78rem;color:var(--text-muted);">@group.Count() column@(group.Count()==1?"":"s")</span>
        </div>
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th>Column</th><th>Data Type</th><th>Key</th><th>Nullable?</th>
                        <th>Description</th><th>Business Rule</th><th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in group.OrderBy(e => e.IsPrimaryKey ? 0 : 1).ThenBy(e => e.ColumnName))
                    {
                        <tr>
                            <td>
                                <span style="font-weight:600;font-family:monospace;font-size:0.85rem;">@entry.ColumnName</span>
                                @if (!string.IsNullOrWhiteSpace(entry.AllowedValues))
                                {
                                    <div style="font-size:0.72rem;color:var(--text-muted);margin-top:2px;">Values: @entry.AllowedValues</div>
                                }
                            </td>
                            <td><code style="font-size:0.8rem;background:var(--bg-soft);padding:2px 6px;border-radius:4px;color:var(--info);">@entry.DataType</code></td>
                            <td>
                                @if (entry.IsPrimaryKey) { <span style="color:var(--warning);font-weight:700;font-size:0.8rem;" title="Primary Key">PK</span> }
                                @if (entry.IsForeignKey) { <span style="color:var(--primary);font-weight:700;font-size:0.8rem;margin-left:4px;" title="Foreign Key">FK</span> }
                                @if (!entry.IsPrimaryKey && !entry.IsForeignKey) { <span style="color:var(--text-muted);">—</span> }
                            </td>
                            <td>@(entry.IsNullable ? "<span style='color:var(--success)'>✓ Yes</span>" : "<span style='color:var(--text-muted)'>✗ No</span>")</td>
                            <td style="max-width:280px;font-size:0.83rem;">@(entry.Description ?? "—")</td>
                            <td style="max-width:200px;font-size:0.82rem;color:var(--text-secondary);">@(entry.BusinessRule ?? "—")</td>
                            <td style="text-align:right;">
                                <div style="display:flex;gap:6px;justify-content:flex-end;">
                                    <a href="@Url.Action("Edit",new{id=entry.EntryId})" class="btn btn-glass btn-sm btn-icon"><i class="fa-solid fa-pen"></i></a>
                                    <form asp-action="Delete" method="post" style="display:inline;" onsubmit="return confirm('Remove this entry?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@entry.EntryId" />
                                        <button type="submit" class="btn btn-danger btn-sm btn-icon"><i class="fa-solid fa-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon"><i class="fa-solid fa-book-open"></i></div>
        <h4>No entries found</h4>
        <p>Start documenting your database schema.</p>
    </div>
}
