@model Participant
@{
    ViewData["Title"] = "Edit Participant";
    ViewData["PageTitle"] = "Edit Participant";
}

<div class="page-header">
    <div class="page-header-title">
        <h2><i class="fa-solid fa-pen" style="color:var(--primary);margin-right:10px;"></i>Edit Participant</h2>
        <p>Updating record for <strong>@Model.FirstName @Model.LastName</strong> — MRN: @Model.MRN</p>
    </div>
    <a href="@Url.Action("Details",new{id=Model.ParticipantId})" class="btn btn-secondary">
        <i class="fa-solid fa-arrow-left"></i> Back
    </a>
</div>

<div style="max-width:860px;">
    <form asp-action="Edit" asp-route-id="@Model.ParticipantId" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ParticipantId" />
        <input type="hidden" asp-for="CreatedAt" />
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="card">
            <div class="card-body">
                <div class="form-section">
                    <div class="form-section-title">Personal Information</div>
                    <div class="form-grid-3">
                        <div class="form-group">
                            <label class="form-label" asp-for="MRN">MRN <span class="required">*</span></label>
                            <input asp-for="MRN" class="form-control" />
                            <span asp-validation-for="MRN" class="field-validation-error"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="FirstName">First Name <span class="required">*</span></label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="field-validation-error"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="LastName">Last Name <span class="required">*</span></label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="field-validation-error"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="DateOfBirth">Date of Birth <span class="required">*</span></label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="Gender">Gender <span class="required">*</span></label>
                            <select asp-for="Gender" class="form-control">
                                <option>Male</option><option>Female</option><option>Non-binary</option><option>Prefer not to say</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="Status">Status</label>
                            <select asp-for="Status" class="form-control">
                                <option>Active</option><option>Pending</option><option>Withdrawn</option><option>Completed</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="Address">Address</label>
                        <input asp-for="Address" class="form-control" />
                    </div>
                </div>

                <div class="form-section">
                    <div class="form-section-title">Guardian Contact</div>
                    <div class="form-grid-3">
                        <div class="form-group" style="grid-column:1/3;">
                            <label class="form-label" asp-for="GuardianName">Guardian Full Name <span class="required">*</span></label>
                            <input asp-for="GuardianName" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="EnrollmentDate">Enrollment Date</label>
                            <input asp-for="EnrollmentDate" type="date" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="GuardianPhone">Phone <span class="required">*</span></label>
                            <input asp-for="GuardianPhone" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="GuardianEmail">Email</label>
                            <input asp-for="GuardianEmail" type="email" class="form-control" />
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <div class="form-section-title">Notes</div>
                    <div class="form-group mb-0">
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>
            <div class="card-footer" style="display:flex;gap:10px;justify-content:flex-end;">
                <a href="@Url.Action("Details",new{id=Model.ParticipantId})" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
