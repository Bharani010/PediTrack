@model Participant
@{ ViewData["Title"] = "Remove Participant"; ViewData["PageTitle"] = "Remove Participant"; }

<div style="max-width:560px;margin:0 auto;">
    <div class="card" style="border-color:rgba(239,68,68,0.25);">
        <div class="card-header" style="background:rgba(239,68,68,0.04);">
            <span class="card-header-title" style="color:var(--danger);">
                <i class="fa-solid fa-triangle-exclamation" style="margin-right:8px;"></i>Confirm Removal
            </span>
        </div>
        <div class="card-body" style="text-align:center;padding:32px;">
            <div style="width:64px;height:64px;background:rgba(239,68,68,0.1);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:1.8rem;color:var(--danger);">
                <i class="fa-solid fa-user-xmark"></i>
            </div>
            <h4 style="margin-bottom:6px;">Remove @Model.FirstName @Model.LastName?</h4>
            <p style="color:var(--text-secondary);font-size:0.9rem;margin-bottom:4px;">MRN: <strong>@Model.MRN</strong></p>
            <p style="color:var(--text-muted);font-size:0.85rem;">
                This will permanently delete this participant and all associated visits, enrollments, and consent records. This action cannot be undone.
            </p>
        </div>
        <div class="card-footer" style="display:flex;gap:10px;justify-content:center;">
            <a href="@Url.Action("Details",new{id=Model.ParticipantId})" class="btn btn-secondary">
                <i class="fa-solid fa-arrow-left"></i> Cancel
            </a>
            <form asp-action="Delete" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ParticipantId" />
                <button type="submit" class="btn btn-danger">
                    <i class="fa-solid fa-trash"></i> Yes, Remove Permanently
                </button>
            </form>
        </div>
    </div>
</div>
