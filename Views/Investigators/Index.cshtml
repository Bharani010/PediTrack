@model List<Investigator>
@{
    ViewData["Title"] = "Investigators";
    ViewData["PageTitle"] = "Investigators & Research Staff";
}

<div class="page-header">
    <div class="page-header-title">
        <h2><i class="fa-solid fa-user-doctor" style="color:var(--primary);margin-right:10px;"></i>Investigators & Staff</h2>
        <p>Research team members at Meridian Children's Hospital</p>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Add Member</a>
</div>

<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:18px;">
    @foreach (var inv in Model)
    {
        var initials = $"{inv.FirstName[0]}{inv.LastName[0]}".ToUpper();
        <div class="card" style="transition:box-shadow 0.2s,transform 0.2s;" onmouseover="this.style.boxShadow='var(--shadow)';this.style.transform='translateY(-2px)'" onmouseout="this.style.boxShadow='';this.style.transform=''">
            <div class="card-body" style="padding:20px;">
                <div style="display:flex;gap:14px;align-items:center;margin-bottom:14px;">
                    <div style="width:48px;height:48px;background:linear-gradient(135deg,var(--primary),var(--accent2));border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:1rem;flex-shrink:0;">
                        @initials
                    </div>
                    <div>
                        <div style="font-weight:700;font-size:0.95rem;">@inv.Title @inv.FirstName @inv.LastName</div>
                        <div style="font-size:0.78rem;color:var(--text-muted);">@inv.Department</div>
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:auto 1fr;gap:6px 10px;font-size:0.82rem;margin-bottom:14px;">
                    <span style="color:var(--text-muted);">Role</span><span>@inv.Role</span>
                    <span style="color:var(--text-muted);">Email</span><span style="word-break:break-all;">@inv.Email</span>
                    @if (!string.IsNullOrWhiteSpace(inv.Phone))
                    { <span style="color:var(--text-muted);">Phone</span><span>@inv.Phone</span> }
                    <span style="color:var(--text-muted);">Studies</span><span>@inv.Studies.Count</span>
                </div>
                <div style="display:flex;gap:8px;">
                    <a href="@Url.Action("Details",new{id=inv.InvestigatorId})" class="btn btn-glass btn-sm" style="flex:1;justify-content:center;">View</a>
                    <a href="@Url.Action("Edit",new{id=inv.InvestigatorId})" class="btn btn-outline-primary btn-sm btn-icon"><i class="fa-solid fa-pen"></i></a>
                    <a href="@Url.Action("Delete",new{id=inv.InvestigatorId})" class="btn btn-danger btn-sm btn-icon"><i class="fa-solid fa-trash"></i></a>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon"><i class="fa-solid fa-user-doctor"></i></div>
        <h4>No investigators found</h4>
        <a href="@Url.Action("Create")" class="btn btn-primary" style="margin-top:12px;"><i class="fa-solid fa-plus"></i> Add First Member</a>
    </div>
}
