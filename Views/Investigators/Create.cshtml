@model Investigator
@{
    ViewData["Title"] = "Add Investigator";
    ViewData["PageTitle"] = "Add Investigator";
}

<div class="page-header">
    <div class="page-header-title">
        <h2><i class="fa-solid fa-user-plus" style="color:var(--primary);margin-right:10px;"></i>Add Research Staff Member</h2>
        <p>Register a new investigator or research staff member</p>
    </div>
    <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Back to List</a>
</div>

<div style="max-width:800px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="card">
            <div class="card-body">

                <!-- Personal Info -->
                <div class="form-section">
                    <div class="form-section-title"><i class="fa-solid fa-id-card" style="margin-right:6px;"></i>Personal Information</div>
                    <div class="form-grid-3">
                        <div class="form-group">
                            <label class="form-label" asp-for="Title">Title</label>
                            <select asp-for="Title" class="form-control">
                                <option>Dr.</option>
                                <option>Prof.</option>
                                <option>Mr.</option>
                                <option>Ms.</option>
                                <option>Mrs.</option>
                                <option value="">—</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="FirstName">First Name <span class="required">*</span></label>
                            <input asp-for="FirstName" class="form-control" placeholder="First name" />
                            <span asp-validation-for="FirstName" class="field-validation-error"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="LastName">Last Name <span class="required">*</span></label>
                            <input asp-for="LastName" class="form-control" placeholder="Last name" />
                            <span asp-validation-for="LastName" class="field-validation-error"></span>
                        </div>
                    </div>
                </div>

                <!-- Role & Affiliation -->
                <div class="form-section">
                    <div class="form-section-title"><i class="fa-solid fa-building" style="margin-right:6px;"></i>Role & Affiliation</div>
                    <div class="form-grid-2">
                        <div class="form-group">
                            <label class="form-label" asp-for="Role">Role <span class="required">*</span></label>
                            <select asp-for="Role" class="form-control">
                                <option>Principal Investigator</option>
                                <option>Co-Investigator</option>
                                <option>Study Coordinator</option>
                                <option>Research Staff</option>
                                <option>Biostatistician</option>
                                <option>Data Manager</option>
                                <option>Research Nurse</option>
                            </select>
                            <span asp-validation-for="Role" class="field-validation-error"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="Status">Status</label>
                            <select asp-for="Status" class="form-control">
                                <option>Active</option>
                                <option>Inactive</option>
                                <option>On Leave</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="Department">Department</label>
                            <input asp-for="Department" class="form-control" placeholder="e.g. Pediatric Oncology" />
                            <span asp-validation-for="Department" class="field-validation-error"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="Institution">Institution</label>
                            <input asp-for="Institution" class="form-control" />
                            <span asp-validation-for="Institution" class="field-validation-error"></span>
                        </div>
                    </div>
                </div>

                <!-- Contact -->
                <div class="form-section">
                    <div class="form-section-title"><i class="fa-solid fa-envelope" style="margin-right:6px;"></i>Contact</div>
                    <div class="form-grid-2">
                        <div class="form-group">
                            <label class="form-label" asp-for="Email">Email <span class="required">*</span></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="name@hospital.org" />
                            <span asp-validation-for="Email" class="field-validation-error"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="Phone">Phone</label>
                            <input asp-for="Phone" class="form-control" placeholder="713-555-0000" />
                            <span asp-validation-for="Phone" class="field-validation-error"></span>
                        </div>
                    </div>
                </div>

                <!-- Notes -->
                <div class="form-section">
                    <div class="form-section-title"><i class="fa-solid fa-note-sticky" style="margin-right:6px;"></i>Notes</div>
                    <div class="form-group mb-0">
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Any additional notes about this staff member…"></textarea>
                    </div>
                </div>
            </div>
            <div class="card-footer" style="display:flex;gap:10px;justify-content:flex-end;">
                <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save Member</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
