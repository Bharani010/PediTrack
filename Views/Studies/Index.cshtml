@model List<Study>
@{
    ViewData["Title"] = "Studies";
    ViewData["PageTitle"] = "Research Studies";
    var currentStatus = ViewBag.Status as string ?? "All";
    var statuses = new[] { "All", "Active", "Recruiting", "Closed", "Suspended" };
}

<div class="page-header">
    <div class="page-header-title">
        <h2><i class="fa-solid fa-flask" style="color:var(--primary);margin-right:10px;"></i>Research Studies</h2>
        <p>Manage all pediatric research studies at Meridian Children's Hospital</p>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-primary"><i class="fa-solid fa-plus"></i> New Study</a>
</div>

<div class="filter-bar">
    <form method="get" style="display:flex;gap:10px;flex-wrap:wrap;width:100%;align-items:center;">
        @foreach (var s in statuses)
        {
            <a href="@Url.Action("Index", new{status = s == "All" ? null : s})"
               class="btn @(currentStatus == s ? "btn-primary" : "btn-secondary") btn-sm">@s</a>
        }
    </form>
</div>

<div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(360px,1fr)); gap:18px;">
    @foreach (var study in Model)
    {
        <div class="card" style="transition:box-shadow 0.2s,transform 0.2s;" onmouseover="this.style.boxShadow='var(--shadow)';this.style.transform='translateY(-2px)'" onmouseout="this.style.boxShadow='';this.style.transform=''">
            <div class="card-body" style="padding:20px;">
                <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px;">
                    <div>
                        <code style="font-size:0.78rem;color:var(--primary);background:var(--primary-light);padding:3px 8px;border-radius:4px;">@study.StudyCode</code>
                        @if (!string.IsNullOrWhiteSpace(study.IRBNumber))
                        {
                            <code style="font-size:0.78rem;color:var(--text-muted);background:var(--bg-soft);padding:3px 8px;border-radius:4px;margin-left:6px;">IRB: @study.IRBNumber</code>
                        }
                    </div>
                    <span class="badge badge-@study.Status.ToLower()">@study.Status</span>
                </div>

                <h4 style="font-size:1rem;font-weight:700;margin:0 0 6px;color:var(--text-primary);">@study.StudyName</h4>

                @if (!string.IsNullOrWhiteSpace(study.Description))
                {
                    <p style="font-size:0.82rem;color:var(--text-secondary);margin:0 0 14px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">@study.Description</p>
                }

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px;">
                    <div>
                        <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.5px;color:var(--text-muted);margin-bottom:2px;">PI</div>
                        <div style="font-size:0.85rem;font-weight:600;">
                            @(study.PrincipalInvestigator != null ? $"{study.PrincipalInvestigator.Title} {study.PrincipalInvestigator.LastName}" : "—")
                        </div>
                    </div>
                    <div>
                        <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.5px;color:var(--text-muted);margin-bottom:2px;">Phase</div>
                        <div style="font-size:0.85rem;font-weight:600;">@(study.Phase ?? "—")</div>
                    </div>
                    <div>
                        <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.5px;color:var(--text-muted);margin-bottom:2px;">Start Date</div>
                        <div style="font-size:0.85rem;">@study.StartDate.ToString("MMM yyyy")</div>
                    </div>
                    <div>
                        <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.5px;color:var(--text-muted);margin-bottom:2px;">Enrolled / Max</div>
                        <div style="font-size:0.85rem;">@study.StudyEnrollments.Count / @(study.MaxParticipants?.ToString() ?? "—")</div>
                    </div>
                </div>

                @if (study.MaxParticipants.HasValue && study.MaxParticipants > 0)
                {
                    var pct = Math.Min(100, (int)((study.StudyEnrollments.Count / (double)study.MaxParticipants.Value) * 100));
                    <div style="height:4px;background:var(--border);border-radius:2px;margin-bottom:14px;overflow:hidden;">
                        <div style="height:100%;width:@pct%;background:linear-gradient(90deg,var(--primary),var(--accent2));border-radius:2px;transition:width 0.5s;"></div>
                    </div>
                }

                <div style="display:flex;gap:8px;">
                    <a href="@Url.Action("Details",new{id=study.StudyId})" class="btn btn-primary btn-sm" style="flex:1;justify-content:center;">
                        <i class="fa-solid fa-eye"></i> View
                    </a>
                    <a href="@Url.Action("Edit",new{id=study.StudyId})" class="btn btn-glass btn-sm btn-icon" title="Edit"><i class="fa-solid fa-pen"></i></a>
                    <a href="@Url.Action("Delete",new{id=study.StudyId})" class="btn btn-danger btn-sm btn-icon" title="Delete"><i class="fa-solid fa-trash"></i></a>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon"><i class="fa-solid fa-flask"></i></div>
        <h4>No studies found</h4>
        <p>Create your first research study to get started.</p>
        <a href="@Url.Action("Create")" class="btn btn-primary" style="margin-top:12px;">
            <i class="fa-solid fa-plus"></i> Create Study
        </a>
    </div>
}
