@model Study
@{
    ViewData["Title"] = "Create Study";
    ViewData["PageTitle"] = "Create Study";
}

<div class="page-header">
    <div class="page-header-title">
        <h2><i class="fa-solid fa-flask" style="color:var(--primary);margin-right:10px;"></i>Create Research Study</h2>
    </div>
    <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Back</a>
</div>

<div style="max-width:860px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <div class="card">
            <div class="card-body">
                <div class="form-section">
                    <div class="form-section-title">Study Identification</div>
                    <div class="form-grid-2">
                        <div class="form-group">
                            <label class="form-label" asp-for="StudyCode">Study Code <span class="required">*</span></label>
                            <input asp-for="StudyCode" class="form-control" placeholder="e.g. MCH-ONC-005" />
                            <span asp-validation-for="StudyCode" class="field-validation-error"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="IRBNumber">IRB Number</label>
                            <input asp-for="IRBNumber" class="form-control" placeholder="e.g. IRB-2025-0001" />
                        </div>
                        <div class="form-group" style="grid-column:1/-1;">
                            <label class="form-label" asp-for="StudyName">Study Name <span class="required">*</span></label>
                            <input asp-for="StudyName" class="form-control" placeholder="Full study title" />
                            <span asp-validation-for="StudyName" class="field-validation-error"></span>
                        </div>
                        <div class="form-group" style="grid-column:1/-1;">
                            <label class="form-label" asp-for="Description">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief study description…"></textarea>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <div class="form-section-title">Study Parameters</div>
                    <div class="form-grid-3">
                        <div class="form-group">
                            <label class="form-label" asp-for="Status">Status</label>
                            <select asp-for="Status" class="form-control">
                                <option>Active</option><option>Recruiting</option><option>Suspended</option><option>Closed</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="Phase">Phase</label>
                            <select asp-for="Phase" class="form-control">
                                <option value="">-- Select --</option>
                                <option>Phase I</option><option>Phase II</option><option>Phase III</option><option>Phase IV</option><option>Observational</option><option>Pilot</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="MaxParticipants">Max Participants</label>
                            <input asp-for="MaxParticipants" type="number" class="form-control" min="1" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="StartDate">Start Date <span class="required">*</span></label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                            <span asp-validation-for="StartDate" class="field-validation-error"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="EndDate">End Date</label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="PrincipalInvestigatorId">Principal Investigator</label>
                            <select asp-for="PrincipalInvestigatorId" class="form-control"
                                    asp-items="@(new SelectList(ViewBag.Investigators, "InvestigatorId", "FullName"))">
                                <option value="">-- Select PI --</option>
                            </select>
                        </div>
                        <div class="form-group" style="grid-column:1/-1;">
                            <label class="form-label" asp-for="Sponsor">Sponsor / Funding Source</label>
                            <input asp-for="Sponsor" class="form-control" placeholder="e.g. NIH, Internal, Industry" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer" style="display:flex;gap:10px;justify-content:flex-end;">
                <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Create Study</button>
            </div>
        </div>
    </form>
</div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
